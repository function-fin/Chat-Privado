local TargetIndicator

local function AjustarAlturaHistoricos(indicadorVisivel)
    local novaPos, novaAlt
    
    if modoFocoAtivo then
        novaPos = UDim2.new(0, 12, 0, 40)
        novaAlt = indicadorVisivel and UDim2.new(1, -24, 1, -117) or UDim2.new(1, -24, 1, -92)
    else
        novaPos = UDim2.new(0, 12, 0, 68)
        novaAlt = indicadorVisivel and UDim2.new(1, -24, 1, -145) or UDim2.new(1, -24, 1, -120)
    end
    
    G2L.ServerHistory.Position = novaPos
    G2L.ServerHistory.Size = novaAlt
    
    G2L.GlobalHistory.Position = novaPos
    G2L.GlobalHistory.Size = novaAlt
    
    for _, data in pairs(abasPrivadas) do
        if data.HistoryFrame then
            data.HistoryFrame.Position = novaPos
            data.HistoryFrame.Size = novaAlt
        end
    end
end

local function OcultarTodasAsAbas()
    G2L.ServerHistory.Visible = false
    G2L.GlobalHistory.Visible = false
    for _, data in pairs(abasPrivadas) do
        if data.HistoryFrame then
            data.HistoryFrame.Visible = false
        end
    end
end

local function AtualizarEstiloAbas()
    for id, btn in pairs(botoesAbasFixas) do
        if id == abaAtual then
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.TextColor3 = Color3.fromRGB(160, 160, 160)
        end
    end

    for user, data in pairs(abasPrivadas) do
        if user == abaAtual then
            data.TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            data.TabBtn.TextColor3 = Color3.fromRGB(160, 160, 160)
        end
    end
end

local function SelecionarAba(nomeAba)
    OcultarTodasAsAbas()
    abaAtual = nomeAba

    if nomeAba == "SERVER" then
        modoGlobal = false
        destinatarioPrivado = nil
        G2L.Title.Text = "CHAT SERVIDOR SPWNCUB"
        G2L.ServerHistory.Visible = true
    elseif nomeAba == "GLOBAL" then
        modoGlobal = true
        destinatarioPrivado = nil
        G2L.Title.Text = "CHAT GLOBAL SPWNCUB"
        G2L.GlobalHistory.Visible = true
    else
        destinatarioPrivado = nomeAba
        G2L.Title.Text = "PV: @" .. string.upper(nomeAba)
        if abasPrivadas[nomeAba] then
            abasPrivadas[nomeAba].UnreadCount = 0
            abasPrivadas[nomeAba].TabBtn.Text = "@" .. nomeAba
            abasPrivadas[nomeAba].HistoryFrame.Visible = true
        end
    end

    AtualizarEstiloAbas()
end

local function CriarBotaoAbaFixa(texto, abaId, layoutOrder)
    local btn = Instance.new("TextButton")
    btn.Name = "Tab_" .. abaId
    btn.Size = UDim2.new(0, 0, 1, 0)
    btn.AutomaticSize = Enum.AutomaticSize.X
    btn.BackgroundTransparency = 1
    btn.Text = texto
    btn.Font = FONTE_PIXEL
    btn.TextColor3 = Color3.fromRGB(160, 160, 160)
    btn.TextSize = 13
    btn.LayoutOrder = layoutOrder
    btn.ZIndex = 7
    btn.Parent = G2L.TabBar

    btn.MouseButton1Click:Connect(function()
        SelecionarAba(abaId)
    end)

    botoesAbasFixas[abaId] = btn
    return btn
end


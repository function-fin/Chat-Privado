-- LÓGICA DE APLICAR / REMOVER MUTE COMPLETO
local function RedesenharListaMutados()
    for _, child in pairs(MutedScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    for user, _ in pairs(jogadoresMutados) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 22)
        btn.BackgroundTransparency = 1
        btn.Text = "@" .. user
        btn.Font = FONTE_PIXEL
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 12
        btn.ZIndex = 32
        btn.Parent = MutedScroll

        btn.MouseButton1Click:Connect(function()
            -- DESMUTAR JOGADOR
            jogadoresMutados[user] = nil
            
            -- Exibe as mensagens dele novamente
            if historicoMensagensInstancias[user] then
                for _, msgBtn in ipairs(historicoMensagensInstancias[user]) do
                    if msgBtn and msgBtn.Parent then
                        msgBtn.Visible = true
                    end
                end
            end

            RedesenharListaMutados()
        end)
    end
end

local function SilenciarJogador(username)
    if username == Player.Name then return end

    jogadoresMutados[username] = true

    -- Esconde todas as mensagens já enviadas por ele
    if historicoMensagensInstancias[username] then
        for _, msgBtn in ipairs(historicoMensagensInstancias[username]) do
            if msgBtn and msgBtn.Parent then
                msgBtn.Visible = false
            end
        end
    end

    -- Fecha o Chat PV se estiver aberto com ele
    FecharAbaPrivada(username)

    -- Se o target indicator estiver direcionado a ele, limpa
    if destinatarioPrivado == username then
        destinatarioPrivado = nil
        if TargetIndicator then TargetIndicator.Visible = false end
        AjustarAlturaHistoricos(false)
    end

    RedesenharListaMutados()
end

local function DispararToast(senderUsername, message)
    if jogadoresMutados[senderUsername] then return end

    ToastText.Text = string.format("<font color='rgb(255,255,255)'>@%s:</font> %s", senderUsername, message)
    ToastText.RichText = true
    ToastFrame.Visible = true
    ToastFrame.Position = UDim2.new(0.05, 0, 0, 5)

    if toastTimerThread then task.cancel(toastTimerThread) end

    ToastGoBtn.MouseButton1Click:Connect(function()
        OcultarToast()
        local data = criarAbaPrivada(senderUsername)
        data.Container.Visible = true
        SelecionarAba(senderUsername)
    end)

    toastTimerThread = task.delay(5, function()
        OcultarToast()
    end)
end

